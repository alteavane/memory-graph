# Copy this file to .env and fill in the values
# cp .env.example .env

# --- Database ---
MEMORYGRAPH_DB_PATH=data/memorygraph.kuzu

# --- LLM Provider ---
# Possible values: anthropic, openai (leave empty to auto-detect from the API key)
# MEMORYGRAPH_LLM_PROVIDER=anthropic

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# MEMORYGRAPH_ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# MEMORYGRAPH_OPENAI_MODEL=gpt-4o-mini
